spring:
  application:
    name: gateway-service
  data:
    redis:
      host: localhost
      port: 6379
  cloud:
    gateway:
      server:
        webflux:
          routes:
            - id: auth-route
              uri: lb://auth-service
              predicates:
                - Path=/api/auth/**
            - id: tenant-route
              uri: lb://tenant-service
              predicates:
                - Path=/api/tenants/**,/api/plans/**
            - id: project-route
              uri: lb://project-service
              predicates:
                - Path=/api/projects/**,/api/tasks/**,/api/comments/**
            - id: billing-route
              uri: lb://billing-service
              predicates:
                - Path=/api/billing/**

server:
  port: 8080

eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka/
  instance:
    prefer-ip-address: true
