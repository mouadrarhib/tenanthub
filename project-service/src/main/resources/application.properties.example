spring.application.name=project-service
server.port=8083

spring.datasource.url=jdbc:postgresql://localhost:5432/tenanthub_project
spring.datasource.username=postgres
spring.datasource.password=changeme
spring.flyway.enabled=true

# auth-service signs JWTs with jjwt + HS256 using this shared secret (not a real
# OIDC/OAuth2 issuer, so no issuer-uri/JWK discovery here) - must match auth-service's
# jwt.secret exactly. security/SecurityConfig builds a JwtDecoder from it.
jwt.secret=changeme-replace-with-a-strong-secret-key

spring.kafka.bootstrap-servers=localhost:9092
spring.kafka.producer.key-serializer=org.apache.kafka.common.serialization.StringSerializer
spring.kafka.producer.value-serializer=org.springframework.kafka.support.serializer.JsonSerializer

eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
