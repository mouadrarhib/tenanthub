{
  "title": "TenantHub — Kafka",
  "uid": "tenanthub-kafka",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Consumer Lag by Group",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "kafka_consumergroup_group_sum_lag",
          "legendFormat": "{{group}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Consumer Lag by Topic",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (topic) (kafka_consumergroup_group_topic_sum_lag)",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Messages In/sec by Topic",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (topic) (rate(kafka_server_brokertopicmetrics_messagesin_total{topic!=\"\"}[1m]))",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Bytes In/Out per sec by Topic",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (topic) (rate(kafka_server_brokertopicmetrics_bytesin_total{topic!=\"\"}[1m]))",
          "legendFormat": "{{topic}} in",
          "refId": "A"
        },
        {
          "expr": "sum by (topic) (rate(kafka_server_brokertopicmetrics_bytesout_total{topic!=\"\"}[1m]))",
          "legendFormat": "{{topic}} out",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "Time Lag (seconds) by Topic",
      "description": "Per-topic time-lag estimate from kafka-lag-exporter. Known upstream limitation: idle-topic extrapolation can occasionally overstate lag on low-traffic partitions (seglo/kafka-lag-exporter #121, #37).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "max by (topic) (kafka_consumergroup_group_lag_seconds)",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ]
    }
  ]
}
